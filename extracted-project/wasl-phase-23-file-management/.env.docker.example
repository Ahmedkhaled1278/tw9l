# Copy to .env.docker and replace every example secret before running.
POSTGRES_USER=wasl
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=wasl
DATABASE_URL=postgresql://wasl:replace-with-a-long-random-database-password@db:5432/wasl
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:3000
PG_POOL_MAX=10
MAX_UPLOAD_MB=5
