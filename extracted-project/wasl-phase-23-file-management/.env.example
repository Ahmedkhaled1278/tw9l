NODE_ENV=development
HOST=0.0.0.0
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters-before-running
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Optional PostgreSQL. When set, PostgreSQL is used instead of local JSON storage.
# Use a private database URL and enable TLS for hosted databases.
DATABASE_URL=
PGSSL=false
PG_POOL_MAX=5
# For production hosted databases, set PGSSL=true (certificate verification stays enabled).

# Per-account quota for uploaded attachments + profile avatar (minimum 10 MB)
ACCOUNT_STORAGE_QUOTA_MB=100
