NODE_ENV=production
HOST=0.0.0.0
PORT=3000
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=https://your-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PGSSL=true
PG_POOL_MAX=5
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Per-account quota for uploaded attachments + profile avatar (minimum 10 MB)
ACCOUNT_STORAGE_QUOTA_MB=100
